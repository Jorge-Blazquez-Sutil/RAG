# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore — nunca lo subas al repositorio.

# ---------- Aplicación ----------
ENVIRONMENT=local
DEBUG=true

# ---------- Generación (LLM) ----------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Alternativa local (rama feature/generation-llm-provider)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ---------- Ingesta y recuperación ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# auto      -> conteo exacto con tiktoken si está disponible; si no, estimación
# tiktoken  -> exige conteo exacto y falla al arrancar la ingesta si no puede cargarlo
# heuristic -> fuerza la estimación por caracteres (despliegues sin salida a internet)
TOKENIZER=auto
TOP_K=5
RERANK_ENABLED=false

# ---------- Almacenamiento ----------
VECTOR_STORE=chroma
COLLECTION_NAME=documents
